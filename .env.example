# Anthropic API key - https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Embeddings API key
VOYAGE_API_KEY=pa-...

# Optional overrides - the defaults in murshid/config.py are what the
# committed index was built with. Changing a model or a chunking value
# means rebuilding the index with `python ingest.py`.
CLAUDE_MODEL=claude-haiku-4-5-20251001
TOP_K_RESULTS=5
